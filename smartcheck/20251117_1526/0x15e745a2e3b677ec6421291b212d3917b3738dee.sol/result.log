content: functionsend(address[]addrs,uint[]amounts,uintnonce){if(addrs.length!=amounts.length||nonce!=nonces[msg.sender])throw;uintval=msg.value;for(uinti=0;i<addrs.length;i++){if(val<amounts[i])throw;if(!addrs[i].send(amounts[i])){balances[addrs[i]]+=amounts[i];}val-=amounts[i];}if(!msg.sender.send(val)){balances[msg.sender]+=val;}nonces[msg.sender]++;}

